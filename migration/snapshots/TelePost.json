{
  "repo": "redtidev1918/TelePost",
  "default_branch": "main",
  "visibility": "public",
  "archived": false,
  "fork": false,
  "template": false,
  "classification": "managed",
  "health": "HEALTHY",
  "release_policy": {
    "kind": "hybrid",
    "versioning": {
      "mode": "release-please"
    },
    "build": {
      "test": "python -m pip install -r requirements-dev.txt && python -m pytest -q --no-cov -o log_cli=false",
      "matrix": [
        {
          "runner": "ubuntu-latest",
          "command": "scripts/build-release",
          "version_check": "./dist/release/telepost-linux-x64 --version | grep -F \"telepost $RELEASE_VERSION\""
        },
        {
          "runner": "windows-latest",
          "command": "scripts/build-release",
          "version_check": "./dist/release/telepost-windows-x64.exe --version | grep -F \"telepost $RELEASE_VERSION\""
        },
        {
          "runner": "macos-14",
          "command": "scripts/build-release",
          "version_check": "./dist/release/telepost-macos-arm64 --version | grep -F \"telepost $RELEASE_VERSION\""
        }
      ]
    },
    "assets": {
      "required": [
        "telepost-linux-x64",
        "telepost-windows-x64.exe",
        "telepost-macos-arm64"
      ],
      "optional": []
    },
    "registries": {
      "github": {
        "required": true
      },
      "ghcr": {
        "required": false,
        "context": ".",
        "file": "Dockerfile",
        "image": "ghcr.io/redtidev1918/telepost",
        "platforms": "linux/amd64,linux/arm64",
        "verify": "docker buildx imagetools inspect ghcr.io/redtidev1918/telepost:$RELEASE_VERSION"
      }
    },
    "release": {
      "post_publish": "python3 .github/scripts/update_download_page.py && git config user.name github-actions[bot] && git config user.email 41898282+github-actions[bot]@users.noreply.github.com && git add docs/download.md && (git diff --cached --quiet || (git commit -m 'docs: update release download page' && git push))"
    },
    "retention": {
      "stable": 1,
      "prerelease": 1,
      "failed_draft": 2
    },
    "checksums": true,
    "sbom": true
  },
  "release_infra_version": "v1",
  "desired_version": "2.15.0",
  "latest_release": "v2.15.0",
  "latest_release_at": "2026-09-08T18:15:58Z",
